   "source": [
    "import pandas as pd\n",
    "import xgboost as xgb\n",
    "from sklearn.metrics import accuracy_score, classification_report\n",
    "import time"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "8c346cb4-f45d-4ec6-8369-a823d11b86d9",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Read the dataset\n",
    "df = pd.read_csv(r'D:\\Downloads\\ml_features_and_labels.csv')\n",
    "\n",
    "# Use the provided split column to create train/test sets and exclude metadata\n",
    "# columns that would leak information about the label.\n",
    "feature_cols = [c for c in df.columns if c not in ['label', 'ID', 'split', 'taxonomy']]\n",
    "\n",
    "X_train = df.loc[df['split'] == 'train', feature_cols]\n",
    "y_train = df.loc[df['split'] == 'train', 'label']\n",
    "\n",
    "X_test = df.loc[df['split'] == 'test', feature_cols]\n",
    "y_test = df.loc[df['split'] == 'test', 'label']"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "8c346cb4-f45d-4ec6-8359-a823d11b86d9",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "6.986027944111776"
     ]
    }
   ],
   "source": [
"neg_count = (y_train == 0).sum()\n"
"pos_count = (y_train == 1).sum()\n"
"scale_pos_weight=(neg_count / pos_count)\n"
"scale_pos_weight\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "9cc0a310-022a-4708-9f64-de193329ed46",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Fitting 9 folds for each of 40 candidates, totalling 360 fits\n",
      "Best parameters found:  {'colsample_bytree': 0.9574798377718904, 'learning_rate': 0.2200077155579599, 'max_depth': 8, 'n_estimators': 1429, 'subsample': 0.5477050582452057}\n",
      "Best score:  0.6059706676805702\n"
     ]
    }
   ],
   "source": [
    "from sklearn.model_selection import RandomizedSearchCV\n",
    "import xgboost as xgb\n",
    "from scipy.stats import randint, uniform\n",
    "\n",
    "# 1. Define model\n",
    "# Assuming scale_pos_weight is already defined in your environment\n",
    "xgb_model = xgb.XGBClassifier(\n",
    "    scale_pos_weight=scale_pos_weight, \n",
    "    random_state=42,\n",
    "    enable_categorical=True # Included based on your earlier XGBoost snippet\n",
    ")\n",
    "\n",
    "# 2. Define parameter grid\n",
    "param_distributions = {\n",
    "    'n_estimators': randint(500, 2000),\n",
    "    'max_depth': randint(5, 12),\n",
    "    'learning_rate': uniform(0.05, 0.2),\n",
    "    # Note: 'num_leaves' was removed because it is primarily a LightGBM parameter.\n",
    "    # XGBoost controls tree complexity mainly through 'max_depth'.\n",
    "    'subsample': uniform(0.5, 0.5),\n",
    "    'colsample_bytree': uniform(0.5, 0.5)\n",
    "}\n",
    "\n",
    "# 3. Setup RandomizedSearch\n",
    "random_search = RandomizedSearchCV(\n",
    "    estimator=xgb_model,\n",
    "    param_distributions=param_distributions,\n",
    "    n_iter=40,          # Number of parameter settings to sample\n",
    "    scoring='f1',       # Metric to optimize\n",
    "    cv=9,               # Cross-validation folds\n",
    "    verbose=1,\n",
    "    random_state=42,\n",
    "    n_jobs=-1           # Use all CPU cores\n",
    ")\n",
    "\n",
    "# 4. Execute search\n",
    "random_search.fit(X_train, y_train)\n",
    "\n",
    "print(\"Best parameters found: \", random_search.best_params_)\n",
    "print(\"Best score: \", random_search.best_score_)\n",
    "\n",
    "# The best model is automatically saved\n",
    "best_model = random_search.best_estimator_"
   ]
  },
  {
